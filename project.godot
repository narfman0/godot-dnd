; Engine configuration file.

config_version=5

[application]

config/name="godot-dnd"
config/description="Reference shell for building SRD 5.2.1 games on godot-srd-addon"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=800

[editor_plugins]

enabled=PackedStringArray("res://addons/srd/plugin.cfg")

[rendering]

renderer/rendering_method="forward_plus"
